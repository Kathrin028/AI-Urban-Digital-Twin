# Backend Environment Configuration
APP_NAME="UrbanMind AI API"
APP_ENV="development"
HOST="127.0.0.1"
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://ai-urban-digital-twin.vercel.app"

# Database Configuration (both MONGODB_URI/MONGO_URI and MONGODB_DB_NAME/DATABASE_NAME supported)
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="urbanmind_ai"

# Security
JWT_SECRET_KEY="urbanmind-development-secret-key-12345"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
